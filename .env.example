# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ---- Mode ----
# DRY_RUN=true  agents build, sign and SDK-verify real transactions but never
#               broadcast; they report to the tally marked as dry-run, and get
#               synthetic starting coins from `npm run seed-agents`.
# DRY_RUN=false live. Transactions are broadcast through Arcade and real
#               satoshis move. Going live is this one switch.
#
# Anything other than an explicit false keeps dry-run, so a typo cannot
# broadcast by accident.
DRY_RUN=true

# ---- Network ----
# Upstream runs on BSV MAINNET. These are real satoshis.
BSV_NETWORK=mainnet

# Arcade: broadcast, tx status and block headers. No API key needed.
# mainnet     https://arcade-v2-us-1.bsvblockchain.tech
# testnet     https://arcade-v2-testnet-us-1.bsvblockchain.tech
ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
ARCADE_CHAINTRACKS_PREFIX=/chaintracks/v2

# Explorer base for the links shown in the UI and logs.
EXPLORER_TX_URL=https://whatsonchain.com/tx/

# ---- Server ----
# Port the tally server listens on. Change it to run two sessions side by side.
PORT=8787

# Where the agent scripts report contributions. Defaults to
# http://localhost:<PORT>, so for a local run setting PORT alone is enough.
# Set it explicitly when the server is somewhere else, or on another port.
SERVER_URL=http://localhost:8787

# Funding round identifier, used in the OP_RETURN tag UPSTREAM|<round>|<projectId>
ROUND=round-1

# ---------------------------------------------------------------------------
# Budget — 200,000 sats total, MAINNET, real money.
#
#   Lisa's agent                      5,000
#   Swarm: 50 agents x 1,500         75,000
#   Whale (one payment)              20,000
#   Attacker: 10 agents x 200         2,000
#   -------------------------------------- funding tx: 102,000
#   Sponsor pool (stays in wallet)   50,000
#   Buffer for fees and retries     ~48,000
#   -------------------------------------- total:     200,000
#
# shared/budget.ts refuses to start if funding + pool exceeds
# TOTAL_BUDGET_SATS, so raise the total deliberately rather than by accident.
# ---------------------------------------------------------------------------

# How many agents to generate and fund.
SWARM_SIZE=50
SYBIL_SIZE=10

# Phase 3: one funding transaction from BSV Desktop, per-agent amounts.
FUND_LISA_SATS=5000
FUND_SWARM_AGENT_SATS=1500
FUND_WHALE_SATS=20000
FUND_SYBIL_AGENT_SATS=200

# Phase 4/6/7: what an agent pays a project per tool call.
CONTRIBUTION_SATS=10
# The whale's single large payment. Below FUND_WHALE_SATS so the tx can pay a fee.
WHALE_CONTRIBUTION_SATS=19500

# Phase 5/9: the sponsor's matching pool. Stays in BSV Desktop until settlement.
SPONSOR_POOL_SATS=50000

# Hard ceiling on funding + pool. The guard rail for the whole demo.
TOTAL_BUDGET_SATS=200000

# ---- Web (Vite: only VITE_* vars reach the browser) ----
# Must point at the same server as SERVER_URL. Vite exposes only VITE_* vars to
# the browser, so this cannot be derived from PORT and has to be set alongside it.
VITE_SERVER_URL=http://localhost:8787

# ---- Lisa's AI agent (Phase 6) ----
# LLM_PROVIDER: anthropic or openai. LLM_API_KEY: that provider's key — never
# commit it; it is never printed. With DRY_RUN=true and no key, `npm run lisa`
# uses a scripted stand-in (clearly labelled, not an LLM) to test payments.
LLM_PROVIDER=
LLM_API_KEY=
# Optional model override (defaults: anthropic claude-opus-5-5, openai gpt-5).
LLM_MODEL=
# Optional cap on paid tool calls per run (default 25).
LISA_MAX_TOOL_CALLS=

# Older name, still read as a fallback when LLM_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
