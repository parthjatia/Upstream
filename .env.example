# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ---- Network ----
# Upstream runs on BSV testnet (PROJECT_BRIEF.md: "Real transactions on BSV testnet").
BSV_NETWORK=testnet

# Arcade: broadcast, tx status and block headers. No API key needed.
# mainnet     https://arcade-v2-us-1.bsvblockchain.tech
# testnet     https://arcade-v2-testnet-us-1.bsvblockchain.tech
# teratestnet https://arcade-v2-ttn-us-1.bsvblockchain.tech
ARCADE_URL=https://arcade-v2-testnet-us-1.bsvblockchain.tech
ARCADE_CHAINTRACKS_PREFIX=/chaintracks/v2

# ---- Server ----
PORT=8787

# Funding round identifier, used in the OP_RETURN tag UPSTREAM|<round>|<projectId>
ROUND=round-1

# ---- Web (Vite: only VITE_* vars reach the browser) ----
VITE_SERVER_URL=http://localhost:8787

# ---- Lisa's AI agent (Phase 6) ----
# Get a key at https://console.anthropic.com/ — never commit it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
