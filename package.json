{
  "name": "upstream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI agents pay the open-source projects they use; a sponsor pool is split by quadratic funding. Settles on BSV.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "agents",
    "web"
  ],
  "scripts": {
    "server": "tsx --env-file-if-exists=.env server/src/index.ts",
    "web": "vite web",
    "build:web": "vite build web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
